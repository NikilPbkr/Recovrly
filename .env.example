# Copy this file to .env in the repository root and fill in the key.
# The app loads .env on startup. A variable already set in the shell is left as-is.
# Standardizing a CSV and running the tests do not need these values.
# .env is gitignored; this file is the template and is safe to commit.

# Required to process disputes (evidence ranking and argument generation).
# The page still loads without it. Processing stops until this is set.
OPENAI_API_KEY=

# Optional chat model for ranking and argument generation.
# Uncomment to override the default, gpt-3.5-turbo.
# Read once, when app.py loads, so set it before starting the app.
# CHARGEBACK_MODEL=gpt-3.5-turbo
